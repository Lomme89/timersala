<Window x:Class="TimerSala.App.Views.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riprendere l'adunanza?" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="Choice" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="22,20,22,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource AmberBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Riprendere l'adunanza?" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Description" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,0,16" />

        <Button Style="{StaticResource Choice}" Click="Count_Click" Background="#16A34A" BorderThickness="0" Foreground="White" IsDefault="True">
            <StackPanel>
                <TextBlock Text="Riprendi contando il tempo trascorso" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Consigliato: l'adunanza è andata avanti mentre TimerSala era chiuso." FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource Choice}" Click="Resume_Click">
            <StackPanel>
                <TextBlock Text="Riprendi da dove era fermo" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="Se anche l'adunanza si è fermata." FontSize="12" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource Choice}" Click="StartOver_Click" IsCancel="True">
            <StackPanel>
                <TextBlock Text="Ricomincia da zero" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="I tempi registrati vengono azzerati." FontSize="12" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
