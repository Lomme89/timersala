<Window x:Class="TimerSala.App.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TimerSala.App.Views"
        Title="TimerSala — Schermo"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="Black" Foreground="{Binding ScreenForeground}"
        FontFamily="{Binding ScreenFont}" Cursor="None"
        Width="1280" Height="720" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <!-- Clessidra orizzontale: il riempimento si accorcia verso sinistra man mano che il tempo passa -->
        <Rectangle Fill="{Binding ScreenPhaseBrush}" Opacity="0.45" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"
                   Visibility="{Binding ShowHourglass, Converter={StaticResource BoolToVis}}">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding RemainingFraction}" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="17*" />
                <RowDefinition Height="69*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="FooterRow" Height="10*" />
            </Grid.RowDefinitions>

            <!-- Titolo della parte -->
            <DockPanel x:Name="Header" VerticalAlignment="Center" Visibility="{Binding ShowScreenHeader, Converter={StaticResource BoolToVis}}">
                <Border x:Name="Chip" DockPanel.Dock="Left" Width="12" CornerRadius="6" Background="{Binding SectionBrush}" Margin="0,0,24,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowScreenSection}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SectionTb" Text="{Binding ScreenSection}" Foreground="{Binding ScreenMuted}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowScreenSection, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="TitleTb" Text="{Binding ScreenTitle}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowScreenTitle, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>

            <!-- Cifre: il segnaposto invisibile mantiene costante la scala del Viewbox -->
            <Viewbox x:Name="DigitsBox" Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
                <Grid>
                    <TextBlock Text="+88:88" Opacity="0" FontSize="200" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="DigitsText" Text="{Binding ScreenDigits}" FontSize="200"
                               HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlashDigits}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Flash">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Flash" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Viewbox>

            <!-- Barra di avanzamento -->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowScreenBar}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowScreenHeader}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border x:Name="Track" Background="{Binding ScreenTrack}" CornerRadius="6" />
                <ProgressBar x:Name="Bar" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Foreground="{Binding ScreenPhaseBrush}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6" Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>

            <!-- Piè di pagina -->
            <DockPanel x:Name="Footer" Grid.Row="3" VerticalAlignment="Center" LastChildFill="True"
                       Visibility="{Binding ShowScreenFooter, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="FooterRight" DockPanel.Dock="Right" Text="{Binding ScreenFooterRight}" Foreground="{Binding ScreenMuted}" Margin="24,0,0,0" />
                <TextBlock x:Name="FooterLeft" Text="{Binding ScreenFooterLeft}" Foreground="{Binding ScreenMuted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <!-- Conto alla rovescia prima dell'adunanza: stili alternativi (lo stile classico usa il layout normale) -->
        <Grid x:Name="CountdownScreen" Visibility="{Binding ShowCountdownScreen, Converter={StaticResource BoolToVis}}">
            <Grid.Resources>
                <Style TargetType="TextBlock" x:Key="CdLabel">
                    <Setter Property="FontFamily" Value="Segoe UI Semibold" />
                    <Setter Property="FontSize" Value="30" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </Grid.Resources>

            <!-- Anello -->
            <Grid Visibility="{Binding CdRing, Converter={StaticResource BoolToVis}}">
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="1.1" RadiusY="0.9">
                        <GradientStop Color="#14324D" Offset="0" />
                        <GradientStop Color="#0A1724" Offset="0.6" />
                        <GradientStop Color="#060D15" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
                <Viewbox>
                    <Grid Width="1280" Height="720">
                        <v:RingArc Width="620" Height="620" Fraction="{Binding CdRemaining}" Stroke="#7FB3D5" Track="#1C3A55" Thickness="16" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CdLabel}" Text="INIZIA TRA" Foreground="#7FB3D5" />
                            <Viewbox Width="470" StretchDirection="DownOnly" Margin="0,-24,0,-18">
                                <TextBlock Text="{Binding CdDigits}" FontFamily="{Binding ScreenFont}" FontSize="220" Foreground="#E8F1F8"
                                           Typography.NumeralAlignment="Tabular" />
                            </Viewbox>
                            <TextBlock Style="{StaticResource CdLabel}" Text="{Binding CdStartLabel}" Foreground="#5F8FB0" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Blocchi dei minuti -->
            <Grid Visibility="{Binding CdBlocks, Converter={StaticResource BoolToVis}}" Background="#0D0F12">
                <Viewbox>
                    <Grid Width="1280" Height="720">
                        <TextBlock Style="{StaticResource CdLabel}" Text="L'ADUNANZA INIZIA TRA" Foreground="#7FB3D5"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="120,70,0,0" />
                        <TextBlock Text="{Binding CdDigits}" FontFamily="{Binding ScreenFont}" FontSize="430" Foreground="#F1ECE3"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="0,0,0,30" />
                        <v:BlockBar Height="30" VerticalAlignment="Bottom" Margin="120,0,120,70" Count="{Binding CdBlockCount}"
                                    Fraction="{Binding CdRemaining}" OnBrush="#7FB3D5" OffBrush="#2A2D33" />
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Orologio -->
            <Grid Visibility="{Binding CdClock, Converter={StaticResource BoolToVis}}" Background="#0B0B0C">
                <Viewbox>
                    <Grid Width="1280" Height="720">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="{Binding ScreenFont}" Typography.NumeralAlignment="Tabular">
                                <Run Text="{Binding ClockText, Mode=OneWay}" FontSize="330" Foreground="#F4F5F7" />
                                <Run Text="{Binding CdClockSeconds, Mode=OneWay}" FontSize="160" Foreground="#55606E" />
                            </TextBlock>
                            <TextBlock Text="{Binding CdClockNote}" FontFamily="Segoe UI" FontSize="52" Foreground="#9AA6B3" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Marea -->
            <Grid Visibility="{Binding CdTide, Converter={StaticResource BoolToVis}}" Background="#071018">
                <v:TideFill Level="{Binding CdLevel}" Phase="{Binding CdPhase}" Crest="#2C7396">
                    <v:TideFill.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1D5A78" Offset="0" />
                            <GradientStop Color="#123A52" Offset="1" />
                        </LinearGradientBrush>
                    </v:TideFill.Fill>
                </v:TideFill>
                <Viewbox>
                    <Grid Width="1280" Height="720">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CdLabel}" Text="INIZIA TRA" Foreground="#A8D0E6" />
                            <TextBlock Text="{Binding CdDigits}" FontFamily="{Binding ScreenFont}" FontSize="360" Foreground="#EAF4FA"
                                       HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" Margin="0,-30,0,0" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Quadrante -->
            <Grid Visibility="{Binding CdDial, Converter={StaticResource BoolToVis}}" Background="#0A0E14">
                <Viewbox>
                    <Grid Width="1280" Height="720">
                        <v:TickDial Width="660" Height="660" Lit="{Binding CdDialLit}" OnBrush="#E8F1F8" OffBrush="#253445" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CdDialBig}" FontFamily="{Binding ScreenFont}" FontSize="300" Foreground="#E8F1F8"
                                       HorizontalAlignment="Center" Margin="0,-40,0,-30" />
                            <TextBlock Style="{StaticResource CdLabel}" Text="{Binding CdDialUnit}" Foreground="#7FB3D5" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- A parole -->
            <Grid Visibility="{Binding CdWords, Converter={StaticResource BoolToVis}}" Background="#0C0C0D">
                <Viewbox>
                    <Grid Width="1280" Height="720">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="si comincia tra" FontFamily="Segoe UI Light" FontSize="110" Foreground="#D9D3C8" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CdWordsBig}" FontFamily="{Binding ScreenFont}" FontSize="230" Foreground="#F4F5F7"
                                       HorizontalAlignment="Center" Margin="0,-30,0,0" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>

        <!-- Messaggio per l'oratore -->
        <Border x:Name="MsgBanner" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#FBBF24" CornerRadius="16"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MsgShift" />
            </Border.RenderTransform>
            <TextBlock x:Name="MsgText" Text="{Binding ScreenMessage}" Foreground="#111111" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
