<Window x:Class="TimerSala.App.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimerSala — Schermo"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="{Binding DisplayBackground}" Foreground="{Binding ScreenForeground}"
        FontFamily="{Binding ScreenFont}" Cursor="None"
        Width="1280" Height="720" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <!-- Clessidra orizzontale: il riempimento si accorcia verso sinistra man mano che il tempo passa -->
        <Rectangle Fill="{Binding ScreenPhaseBrush}" Opacity="0.45" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"
                   Visibility="{Binding ShowHourglass, Converter={StaticResource BoolToVis}}">
            <Rectangle.RenderTransform>
                <ScaleTransform ScaleX="{Binding RemainingFraction}" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="17*" />
                <RowDefinition Height="69*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="FooterRow" Height="10*" />
            </Grid.RowDefinitions>

            <!-- Titolo della parte -->
            <DockPanel x:Name="Header" VerticalAlignment="Center" Visibility="{Binding ShowScreenHeader, Converter={StaticResource BoolToVis}}">
                <Border x:Name="Chip" DockPanel.Dock="Left" Width="12" CornerRadius="6" Background="{Binding SectionBrush}" Margin="0,0,24,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIdle}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowScreenSection}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SectionTb" Text="{Binding ScreenSection}" Foreground="{Binding ScreenMuted}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowScreenSection, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="TitleTb" Text="{Binding ScreenTitle}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowScreenTitle, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>

            <!-- Cifre: il segnaposto invisibile mantiene costante la scala del Viewbox -->
            <Viewbox x:Name="DigitsBox" Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
                <Grid>
                    <TextBlock Text="+88:88" Opacity="0" FontSize="200" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="{Binding ScreenDigits}" Foreground="{Binding ScreenDigitsBrush}" FontSize="200"
                               HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlashDigits}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Flash">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Flash" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Viewbox>

            <!-- Barra di avanzamento -->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowScreenBar}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowScreenHeader}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border x:Name="Track" Background="{Binding ScreenTrack}" CornerRadius="6" />
                <ProgressBar x:Name="Bar" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Foreground="{Binding ScreenPhaseBrush}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="6" Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>

            <!-- Piè di pagina -->
            <DockPanel x:Name="Footer" Grid.Row="3" VerticalAlignment="Center" LastChildFill="True"
                       Visibility="{Binding ShowScreenFooter, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="FooterRight" DockPanel.Dock="Right" Text="{Binding ScreenFooterRight}" Foreground="{Binding ScreenMuted}" Margin="24,0,0,0" />
                <TextBlock x:Name="FooterLeft" Text="{Binding ScreenFooterLeft}" Foreground="{Binding ScreenMuted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <!-- Messaggio per l'oratore -->
        <Border x:Name="MsgBanner" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#FBBF24" CornerRadius="16"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="MsgText" Text="{Binding ScreenMessage}" Foreground="#111111" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
