<Window x:Class="TimerSala.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TimerSala.App.Views"
        Title="TimerSala mini" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/Assets/timersala.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
        </Style>
    </Window.Resources>

    <!-- cornice: diventa rossa allo sforamento -->
    <Border x:Name="Frame" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="Background" Value="{StaticResource BgBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="{StaticResource OvertimeBgBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- barra superiore: titolo della parte, ora, finestra completa (si trascina per spostare) -->
            <DockPanel x:Name="DragBar" Background="Transparent" MouseLeftButtonDown="DragBar_MouseDown" Margin="12,7,6,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Width="26" Height="24" FontSize="11" Content="&#xE740;"
                        Command="{Binding ToggleMiniCommand}" ToolTip="Torna alla finestra completa (M)" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClockText}" FontFamily="{StaticResource DigitsFont}" FontSize="13"
                           Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" Margin="8,0,6,0" />
                <!-- dopo Ferma: «Annulla» al posto del titolo per qualche secondo -->
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Annulla" Padding="8,0" Height="22" FontSize="12"
                        FontWeight="SemiBold" Margin="6,0,0,0" Command="{Binding UndoActionCommand}"
                        ToolTip="Annulla l'ultima azione (Esc)"
                        Visibility="{Binding CanUndoAction, Converter={StaticResource BoolToVis}}" />
                <!-- pallino: colore della sezione; giallo che pulsa mentre la voce è attesa -->
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{Binding SectionBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="VoicePulse">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.7">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="VoicePulse" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <!-- la barra dice cosa sta succedendo: titolo, attesa della voce o «Annulla» -->
                <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding TitleText}" />
                            <Setter Property="ToolTip" Value="{Binding TitleText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                    <Setter Property="Text" Value="{Binding VoiceStatus}" />
                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanUndoAction}" Value="True">
                                    <Setter Property="Text" Value="{Binding UndoActionText}" />
                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <!-- tempo grande e comandi -->
            <Grid Grid.Row="1" Margin="14,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- cifre ritagliate sul contorno: stessa altezza del gruppo di pulsanti -->
                <v:GlyphText Text="{Binding DisplayText}" Fill="{Binding PhaseBrush}" FontFamily="{StaticResource DigitsFont}"
                             Height="62" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MiniButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Parte precedente (←)" />
                        <Button x:Name="StartButton" Height="38" Width="50" Margin="6,0" Command="{Binding ToggleStartCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="Background" Value="#16A34A" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                    <Setter Property="FontSize" Value="18" />
                                    <Setter Property="Content" Value="&#xE768;" />
                                    <Setter Property="ToolTip" Value="Avvia / ferma (Spazio)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="#DC2626" />
                                            <Setter Property="Content" Value="&#xE71A;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                            <Setter Property="Background" Value="#B45309" />
                                            <Setter Property="Content" Value="&#xE720;" />
                                            <Setter Property="ToolTip" Value="In attesa della voce: premi per avviare subito, Esc per annullare" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource MiniButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Parte successiva (→)" />
                    </StackPanel>
                    <!-- stessa larghezza della fila di icone, divisa a metà -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource TinyButton}" Content="−1" Command="{Binding RemoveMinuteCommand}" ToolTip="Un minuto in meno (−)" />
                        <Button Grid.Column="2" Style="{StaticResource TinyButton}" Content="+1" Command="{Binding AddMinuteCommand}" ToolTip="Un minuto in più (+)" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- messaggio all'oratore (se abilitato) -->
            <StackPanel Grid.Row="2" Margin="12,0,12,10" Visibility="{Binding MessagesEnabled, Converter={StaticResource BoolToVis}}">
                <!-- messaggio in onda: pastiglia gialla con «Togli», sparisce quando non c'è nulla sullo schermo -->
                <Border CornerRadius="8" Background="#FBBF24" Padding="10,3,3,3" Margin="0,0,0,6"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ClearMessageCommand}" Cursor="Hand" ToolTip="Togli il messaggio dallo schermo"
                                Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="6" Background="#26000000" Padding="8,2">
                                        <TextBlock Foreground="#111111" FontSize="12" FontWeight="SemiBold">
                                            <Run Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" /><Run Text=" Togli" />
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#40000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Foreground="#111111" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding MessageInfo}">
                            <Run Text="Sullo schermo: " /><Run Text="{Binding ScreenMessage, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" ItemsSource="{Binding MessagePresets}" FontSize="12" MinHeight="28"
                              Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Message_KeyDown"
                              ToolTip="Messaggio per l'oratore (Invio per mostrarlo, Ctrl+Invio a tutto schermo)" />
                    <TextBlock Text="Messaggio…" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="9,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="13" Content="&#xE724;" Margin="4,0,0,0"
                            Command="{Binding SendMessageCommand}" ToolTip="Mostra il messaggio (Invio)" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="13" Content="&#xE740;" Margin="4,0,0,0"
                            Command="{Binding SendMessageFullCommand}" ToolTip="A tutto schermo per qualche secondo (Ctrl+Invio)" />
                </Grid>
            </StackPanel>

            <!-- avanzamento lungo il bordo inferiore -->
            <Grid Grid.Row="3" Height="4">
                <Border Background="{StaticResource CardHoverBrush}" />
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Foreground="{Binding PhaseBrush}" Height="4">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>
        </Grid>
    </Border>
</Window>
