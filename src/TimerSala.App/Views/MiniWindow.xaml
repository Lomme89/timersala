<Window x:Class="TimerSala.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TimerSala.App.Views"
        Title="TimerSala mini" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/Assets/timersala.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#C9CED6" />
        </Style>
    </Window.Resources>

    <!-- cornice: diventa rossa allo sforamento -->
    <Border x:Name="Frame" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="Background" Value="{StaticResource BgBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Background" Value="#1A0B0D" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- barra superiore: titolo della parte, ora, finestra completa (si trascina per spostare) -->
            <DockPanel x:Name="DragBar" Background="Transparent" MouseLeftButtonDown="DragBar_MouseDown" Margin="12,7,6,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Width="26" Height="24" FontSize="11" Content="&#xE740;"
                        Command="{Binding ToggleMiniCommand}" ToolTip="Torna alla finestra completa (M)" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ClockText}" FontFamily="{StaticResource DigitsFont}" FontSize="13"
                           Foreground="#6B7280" VerticalAlignment="Center" Margin="8,0,6,0" />
                <Ellipse Width="8" Height="8" Fill="{Binding SectionBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TitleText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" ToolTip="{Binding TitleText}" />
            </DockPanel>

            <!-- tempo grande e comandi -->
            <Grid Grid.Row="1" Margin="14,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- cifre ritagliate sul contorno: stessa altezza del gruppo di pulsanti -->
                <v:GlyphText Text="{Binding DisplayText}" Fill="{Binding PhaseBrush}" FontFamily="{StaticResource DigitsFont}"
                             Height="62" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MiniButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Parte precedente (←)" />
                        <Button Height="38" Width="50" Margin="6,0" Command="{Binding ToggleStartCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="Background" Value="#16A34A" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                    <Setter Property="FontSize" Value="18" />
                                    <Setter Property="Content" Value="&#xE768;" />
                                    <Setter Property="ToolTip" Value="Avvia / ferma (Spazio)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="#DC2626" />
                                            <Setter Property="Content" Value="&#xE71A;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                            <Setter Property="Background" Value="#B45309" />
                                            <Setter Property="Content" Value="&#xE720;" />
                                            <Setter Property="ToolTip" Value="In attesa della voce: premi per avviare subito, Esc per annullare" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource MiniButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Parte successiva (→)" />
                    </StackPanel>
                    <!-- stessa larghezza della fila di icone, divisa a metà -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource TinyButton}" Content="−1" Command="{Binding RemoveMinuteCommand}" ToolTip="Un minuto in meno (−)" />
                        <Button Grid.Column="2" Style="{StaticResource TinyButton}" Content="+1" Command="{Binding AddMinuteCommand}" ToolTip="Un minuto in più (+)" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- messaggio all'oratore (se abilitato) -->
            <Grid Grid.Row="2" Margin="12,0,12,10" Visibility="{Binding MessagesEnabled, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox IsEditable="True" ItemsSource="{Binding MessagePresets}" FontSize="12" MinHeight="28"
                          Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Message_KeyDown"
                          ToolTip="Messaggio per l'oratore (Invio per mostrarlo)" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="13" Content="&#xE724;" Margin="4,0,0,0"
                        Command="{Binding SendMessageCommand}" ToolTip="Mostra il messaggio" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="13" Content="&#xE711;" Margin="4,0,0,0"
                        Command="{Binding ClearMessageCommand}" ToolTip="Togli il messaggio"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- avanzamento lungo il bordo inferiore -->
            <Grid Grid.Row="3" Height="4">
                <Border Background="{StaticResource CardHoverBrush}" />
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Foreground="{Binding PhaseBrush}" Height="4">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>
        </Grid>
    </Border>
</Window>
