<Window x:Class="TimerSala.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimerSala.App.ViewModels"
        xmlns:v="clr-namespace:TimerSala.App.Views"
        Title="TimerSala"
        Width="440" Height="800" MinWidth="380" MinHeight="560"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/timersala.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:NotNullToVisibility x:Key="NotNullToVis" />

        <DataTemplate x:Key="PartTemplate" DataType="{x:Type vm:PartItemViewModel}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="8,7" Margin="0,1" Cursor="Hand"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding SectionBrush}" CornerRadius="2" />
                    <!-- «⋯»: lo stesso menu del tasto destro -->
                    <Button x:Name="MenuButton" Grid.Column="5" Style="{StaticResource GhostIconButton}" Width="26" Height="24" FontSize="13"
                            Content="&#xE712;" Margin="4,0,-4,0" Click="PartMenu_Click" Tag="{Binding}" Visibility="Collapsed"
                            ToolTip="Modifica, sposta o salta questa parte" />
                    <TextBlock x:Name="Planned" Grid.Column="1" Text="{Binding PlannedStartText}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontFamily="{StaticResource DigitsFont}" FontSize="13" ToolTip="Orario previsto d'inizio" />
                    <StackPanel Grid.Column="2" Margin="6,0,8,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource AmberBrush}"
                                       VerticalAlignment="Center" Margin="0,1,6,0" ToolTip="Parte con un video: preparalo in JW Library"
                                       Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}" />
                            <TextBlock x:Name="TitleTb" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="{StaticResource TextBrush}"
                                       ToolTip="{Binding Title}" />
                        </DockPanel>
                        <TextBlock x:Name="DetailTb" Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock x:Name="Duration" Grid.Column="3" Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" FontFamily="{StaticResource DigitsFont}" FontSize="14" ToolTip="Tempo previsto" />
                    <TextBlock x:Name="Actual" Grid.Column="4" Text="{Binding ActualText}" Foreground="{StaticResource GreenBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource DigitsFont}" FontSize="14"
                               ToolTip="Tempo effettivo" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSong}" Value="True">
                    <Setter TargetName="TitleTb" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="TitleTb" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="TitleTb" Property="FontSize" Value="13" />
                    <Setter TargetName="Planned" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="Row" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="Row" Property="Padding" Value="8,3" />
                </DataTrigger>
                <!-- parti già fatte: compatte, si legge il tempo effettivo -->
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="Row" Property="Padding" Value="8,2" />
                    <Setter TargetName="TitleTb" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="TitleTb" Property="FontSize" Value="12.5" />
                    <Setter TargetName="DetailTb" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Planned" Property="FontSize" Value="12" />
                    <Setter TargetName="Duration" Property="FontSize" Value="12" />
                    <Setter TargetName="Actual" Property="FontSize" Value="12.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOver}" Value="True">
                    <Setter TargetName="Actual" Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAdapted}" Value="True">
                    <Setter TargetName="Duration" Property="Foreground" Value="#F59E0B" />
                    <Setter TargetName="Duration" Property="ToolTip" Value="Durata adattata per recuperare il ritardo" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource CardHoverBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="MenuButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                    <Setter TargetName="Actual" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="Actual" Property="FontFamily" Value="{StaticResource UiFont}" />
                    <Setter TargetName="Actual" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="TitleTb" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <!-- la parte in corso è più grande ed evidenziata -->
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#1A22C55E" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                    <Setter TargetName="Row" Property="Padding" Value="8,10" />
                    <Setter TargetName="TitleTb" Property="FontSize" Value="15.5" />
                    <Setter TargetName="TitleTb" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="MenuButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSong}" Value="True">
                    <Setter TargetName="MenuButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- icone dell'intestazione -->
        <Style x:Key="HeadButton" TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════ Intestazione: ora, ritardo, rete, mini, editor, impostazioni ═════ -->
        <DockPanel Margin="0,0,0,8">
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,7" CornerRadius="10" Background="#263B82F6" BorderBrush="#603B82F6"
                    BorderThickness="1" Visibility="{Binding IsFreeEvent, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Torna all'adunanza" Padding="12,3" Command="{Binding StopFreeEventCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="#93C5FD">
                        <Run Text="EVENTO" FontWeight="Bold" /><Run Text="  ·  " /><Run Text="{Binding FreeEventTitle, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="12,7" CornerRadius="10" Background="#26FBBF24" BorderBrush="{StaticResource AmberBrush}"
                    BorderThickness="1" Visibility="{Binding IsTraining, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Esci" Padding="14,3" Command="{Binding StopTrainingCommand}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource AmberBrush}">
                        <Run Text="ADDESTRAMENTO" FontWeight="Bold" /><Run Text="  ·  le parti durano un decimo del solito, niente viene salvato" />
                    </TextBlock>
                </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid>
                    <ToggleButton x:Name="NetworkButton" Width="34" Height="34" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                  ToolTip="Timer in rete: indirizzo, QR e dispositivi collegati">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Style.Triggers>
                                    <!-- con il riquadro aperto, il clic sull'icona lo chiude soltanto (non lo riapre) -->
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=NetworkPopup}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                    <Grid>
                                        <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,5,0"
                                                 Stroke="{StaticResource BgBrush}" StrokeThickness="1.5">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WebRunning}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <!-- riquadro della rete -->
                    <Popup x:Name="NetworkPopup" IsOpen="{Binding IsChecked, ElementName=NetworkButton, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=NetworkButton}" Placement="Bottom" HorizontalOffset="-266" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="300" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource HoverBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12" Margin="4">
                            <StackPanel>
                                <DockPanel>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WebRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="TIMER IN RETE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock FontFamily="{StaticResource DigitsFont}" FontSize="17" Margin="0,6,0,0" Cursor="Hand" TextWrapping="Wrap"
                                           MouseLeftButtonDown="Address_Click" ToolTip="Clic per copiare l'indirizzo · doppio clic per aprirlo nel browser">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding WebAddressText}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WebRunning}" Value="False">
                                                    <Setter Property="Text" Value="{Binding WebStatus}" />
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ConnectedDevicesText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding WebRunning, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource FlatButton}" Margin="0,12,0,0" Padding="12,7" HorizontalAlignment="Stretch" Click="Qr_Click"
                                        Visibility="{Binding WebRunning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED14;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Collega un telefono (QR)" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Margin="0,6,0,0" Padding="12,7" HorizontalAlignment="Stretch" Click="PrintCard_Click"
                                        Visibility="{Binding WebRunning, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Un foglio con il codice per seguire il timer (senza PIN), da lasciare al leggio o all'acustica">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Stampa il cartoncino" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- comandi dal telefono: interruttore al volo e dispositivi autorizzati -->
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RemoteCommandsEnabled}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Comandi dal telefono" FontSize="13" />
                                                <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap"
                                                           Text="Spento: i telefoni vedono il timer ma non lo comandano." />
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTrustedDevices, Converter={StaticResource BoolToVis}}">
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Revoca tutti" Padding="8,2" FontSize="11.5"
                                                        Command="{Binding RevokeAllDevicesCommand}" />
                                                <TextBlock Text="AUTORIZZATI SENZA PIN" Style="{StaticResource Caption}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding TrustedDevices}" MaxHeight="150">
                                                <ItemsControl.Template>
                                                    <ControlTemplate TargetType="ItemsControl">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE711;" Width="24" Height="24" FontSize="9"
                                                                    ToolTip="Revoca: per comandare dovrà inserire di nuovo il PIN"
                                                                    Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding Id}" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                                                                <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource Caption}" FontSize="11" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Button Style="{StaticResource HeadButton}" Content="&#xE9D5;" ToolTip="Lista di controllo prima dell'adunanza" Command="{Binding ToggleChecklistCommand}"
                        Visibility="{Binding HasChecklist, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource HeadButton}" Content="&#xE73F;" ToolTip="Modalità mini (M)" Command="{Binding ToggleMiniCommand}" />
                <Button Style="{StaticResource HeadButton}" Content="&#xE70F;" ToolTip="Modifica schema (E)" Click="Edit_Click" />
                <Button Style="{StaticResource HeadButton}" Content="&#xE897;" ToolTip="Guida rapida, novità e segnalazioni (F1)" Click="Help_Click" />
                <Button Style="{StaticResource HeadButton}" Content="&#xE713;" ToolTip="Impostazioni" Click="Settings_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource DigitsFont}" FontSize="24" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding ClockSeconds}" FontFamily="{StaticResource DigitsFont}" FontSize="14"
                           Foreground="{StaticResource MutedBrush}" Margin="3,0,0,3" VerticalAlignment="Bottom" />
                <!-- «In orario» / ritardo come pastiglia colorata -->
                <Grid Margin="12,0,0,2" VerticalAlignment="Center" ToolTip="Differenza accumulata rispetto ai tempi assegnati">
                    <Border CornerRadius="11" Background="{Binding DelayBrush}" Opacity="0.16" />
                    <TextBlock Text="{Binding DelayText}" Foreground="{Binding DelayBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="10,3" />
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- ═════ Settimana in una riga; il riquadro completo si apre con la freccia ═════ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <ToggleButton IsChecked="{Binding WeekPanelOpen}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                          ToolTip="Cambia settimana o adunanza, scarica gli schemi, visita del sorvegliante">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="CornerRadius" Value="10,10,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <DockPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource AmberBrush}" Background="#1FFBBF24"
                            Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasOverrun, Converter={StaticResource BoolToVis}}"
                            ToolTip="Le parti dello schema, con i cantici, superano la durata dell'adunanza impostata. Si può sistemare nell'editor.">
                        <TextBlock Text="{Binding OverrunText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE70D;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WeekPanelOpen}" Value="True">
                                        <Setter Property="Text" Value="&#xE70E;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock TextTrimming="CharacterEllipsis" FontSize="14" VerticalAlignment="Center">
                        <Run Text="{Binding MeetingDayText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                        <Run Text="{Binding MeetingLineText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                </DockPanel>
            </ToggleButton>
            <ProgressBar IsIndeterminate="True" Height="2" Margin="6,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10"
                    Padding="10,4,10,10" Visibility="{Binding WeekPanelOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostIconButton}" Content="&#xE76B;" Command="{Binding PreviousWeekCommand}" ToolTip="Settimana precedente" />
                        <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource FlatButton}" Padding="4"
                                Command="{Binding ThisWeekCommand}" ToolTip="Torna alla settimana corrente">
                            <StackPanel>
                                <TextBlock Text="{Binding WeekTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding WeekSubtitle}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GhostIconButton}" Content="&#xE76C;" Command="{Binding NextWeekCommand}" ToolTip="Settimana successiva" />
                        <Button x:Name="DownloadButton" Grid.Column="3" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="Download_Click"
                                ToolTip="Scarica gli schemi da wol.jw.org">
                            <TextBlock Text="&#xE896;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="DownloadWeekItem" Header="Aggiorna questa settimana" Click="DownloadWeek_Click" />
                                    <MenuItem x:Name="DownloadAllItem" Header="Scarica tutte le prossime settimane" Click="DownloadAll_Click" />
                                    <Separator />
                                    <MenuItem Header="Esporta questa settimana…" Click="ExportWeek_Click" />
                                    <MenuItem Header="Importa da file…" Click="ImportFile_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource BgBrush}" CornerRadius="8">
                            <UniformGrid Columns="2">
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Infrasettimanale" IsChecked="{Binding IsMidweek}" GroupName="kind" />
                                <RadioButton Style="{StaticResource SegmentButton}" Content="Fine settimana" IsChecked="{Binding IsWeekend}" GroupName="kind" />
                            </UniformGrid>
                        </Border>
                        <ToggleButton Grid.Column="1" Style="{StaticResource PillToggle}" Margin="8,0,0,0" IsChecked="{Binding OverseerVisit}"
                                      ToolTip="Settimana della visita del sorvegliante di circoscrizione">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Sorvegliante" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                    <TextBlock Text="{Binding ScheduleText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═════ Riquadro del tempo ═════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12,16,12">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="9" Height="9" CornerRadius="4.5" Background="{Binding SectionBrush}" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Pulse">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding SectionText}" Style="{StaticResource Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding TitleText}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" />
                <Viewbox Height="96" StretchDirection="DownOnly" Margin="0,0,0,2">
                    <TextBlock x:Name="Digits" Text="{Binding DisplayText}" Foreground="{Binding PhaseBrush}" FontFamily="{StaticResource DigitsFont}"
                               FontSize="92" Typography.NumeralAlignment="Tabular" />
                </Viewbox>
                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding PhaseBrush}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding InfoText}" Style="{StaticResource Caption}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding CardStartText}" Style="{StaticResource Caption}" FontSize="12.5" HorizontalAlignment="Right" Margin="12,0,0,0" />
                    <TextBlock Grid.Row="1" Text="{Binding CardNextLabel}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,6,0,0"
                               Visibility="{Binding CardNextTitle, Converter={StaticResource NotNullToVis}}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Fine prevista" Style="{StaticResource Caption}" FontSize="12.5" HorizontalAlignment="Right" Margin="12,6,0,0" />
                    <TextBlock Grid.Row="2" Text="{Binding CardNextTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CardNextTitle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CardEndText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"
                               FontFamily="{StaticResource DigitsFont}" Margin="12,0,0,0" ToolTip="Con il ritardo accumulato finora" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═════ Comandi ═════ -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Width="50" Height="56" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Parte precedente (←)" />
                <Button x:Name="StartButton" Grid.Column="1" Height="56" Margin="6,0" Command="{Binding ToggleStartCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                            <Setter Property="Background" Value="#16A34A" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="ToolTip" Value="Avvia / ferma (barra spaziatrice)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="#DC2626" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                    <Setter Property="Background" Value="#B45309" />
                                    <Setter Property="ToolTip" Value="In attesa della voce: premi di nuovo per avviare subito, Esc per annullare" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StartIcon" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                            <Setter Property="Text" Value="&#xE720;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="AVVIA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="FERMA" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                            <Setter Property="Text" Value="IN ATTESA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="50" Height="56" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Parte successiva (→)" HorizontalAlignment="Right" />
            </Grid>
            <!-- annulla una fermata sbagliata, nei secondi successivi -->
            <Border Margin="0,6,0,0" CornerRadius="8" Background="#1FFBBF24" BorderBrush="#55FBBF24" BorderThickness="1" ClipToBounds="True"
                    Visibility="{Binding CanUndoAction, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <DockPanel Margin="10,4,4,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Annulla" Padding="12,2" FontWeight="SemiBold"
                                Command="{Binding UndoActionCommand}" ToolTip="Annulla l'ultima azione (Esc)" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" FontSize="13" Foreground="{StaticResource AmberBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding UndoActionText}" FontSize="12" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Style="{StaticResource SlimProgress}" Height="2" VerticalAlignment="Bottom" Minimum="0" Maximum="1"
                                 Value="{Binding UndoActionFraction, Mode=OneWay}" Foreground="{StaticResource AmberBrush}" Background="Transparent" />
                </Grid>
            </Border>
            <!-- azioni arrivate dal telefono: compaiono per qualche secondo, così si sa chi ha fatto cosa -->
            <Border Margin="0,6,0,0" CornerRadius="8" Background="#1F3B82F6" BorderBrush="#553B82F6" BorderThickness="1" Padding="10,5"
                    Visibility="{Binding HasRemoteNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8EA;" FontSize="13" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding RemoteNotice}" FontSize="12" Foreground="#93C5FD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RemoteNotice}" />
                </DockPanel>
            </Border>
            <!-- avvio con la voce (sperimentale) -->
            <Border Margin="0,6,0,0" CornerRadius="8" Padding="10,5" Background="{StaticResource BgBrush}"
                    Visibility="{Binding VoiceEnabled, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Annulla" Padding="10,2" Margin="8,0,0,0"
                            Command="{Binding CancelVoiceCommand}" ToolTip="Annulla l'attesa o l'avvio fatto dalla voce (Esc)"
                            Visibility="{Binding CanCancelVoice, Converter={StaticResource BoolToVis}}" />
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE720;" FontSize="13" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VoiceHeard}" Value="True">
                                        <Setter Property="Foreground" Value="#22C55E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar DockPanel.Dock="Left" Style="{StaticResource SlimProgress}" Width="56" Margin="8,0,10,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="1" Value="{Binding VoiceLevel, Mode=OneWay}" Foreground="#22C55E" ToolTip="Livello dell'ingresso audio" />
                    <TextBlock Text="{Binding VoiceStatus}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoiceArmed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VoiceError}" Value="True">
                                        <Setter Property="Foreground" Value="#EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Border>
            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Style="{StaticResource FlatButton}" Content="−1 min" Command="{Binding RemoveMinuteCommand}" Margin="0,0,3,0" ToolTip="Togli un minuto (−)" />
                <Button Style="{StaticResource FlatButton}" Content="+1 min" Command="{Binding AddMinuteCommand}" Margin="3,0,0,0" ToolTip="Aggiungi un minuto (+)" />
            </UniformGrid>
            <!-- messaggio all'oratore in una riga; si allarga solo quando un messaggio è sullo schermo -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding MessagesEnabled, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="MessageInput" IsEditable="True" ItemsSource="{Binding MessagePresets}" MinHeight="38" Padding="28,5,6,5"
                              Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" KeyDown="MessageInput_KeyDown"
                              ToolTip="Scegli una frase o scrivila e premi Invio (Ctrl+Invio: a tutto schermo)" />
                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource AmberBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock Text="Messaggio all'oratore…" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="34,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE724;" Margin="6,0,0,0"
                            Command="{Binding SendMessageCommand}" ToolTip="Mostra il messaggio sullo schermo (Invio)" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE740;" Margin="6,0,0,0"
                            Command="{Binding SendMessageFullCommand}" ToolTip="A tutto schermo per qualche secondo, poi nella fascia (Ctrl+Invio)" />
                </Grid>
                <!-- messaggio in onda: pastiglia gialla con «Togli» -->
                <Border Margin="0,6,0,0" CornerRadius="10" Background="#1FFBBF24" BorderBrush="#55FBBF24" BorderThickness="1" Padding="10,4,4,4"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Togli" Padding="10,2" FontSize="12.5"
                                Command="{Binding ClearMessageCommand}" ToolTip="Togli il messaggio dallo schermo" />
                        <TextBlock Text="{Binding MessageInfo}" Foreground="{StaticResource AmberBrush}" FontSize="12.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MessageInfo}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- ═════ Programma ═════ -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="6,10,6,6">
            <DockPanel>
                <!-- lista di controllo: durante il countdown d'inizio o aperta con il pulsante -->
                <Border DockPanel.Dock="Top" Margin="4,0,4,10" Padding="12,10" CornerRadius="10" Background="{StaticResource SubtleBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Visibility="{Binding ChecklistVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="10"
                                    ToolTip="Chiudi" Command="{Binding ToggleChecklistCommand}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChecklistSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChecklistComplete}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="PRIMA DI INIZIARE" Style="{StaticResource Caption}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Checklist}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Done}" Margin="0,3" Cursor="Hand" Foreground="{StaticResource TextBrush}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,0,10,6">
                    <TextBlock DockPanel.Dock="Right" Text="PREVISTO · REALE" Style="{StaticResource Caption}" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="PROGRAMMA" Style="{StaticResource Caption}" FontSize="11" FontWeight="SemiBold" />
                </DockPanel>
                <ListBox x:Name="PartsList" ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartTemplate}" Foreground="{StaticResource TextBrush}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                         PreviewMouseLeftButtonUp="PartsList_Click" PreviewMouseRightButtonUp="PartsList_RightClick" Focusable="False">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="PartMenu" Opened="PartMenu_Opened">
                            <MenuItem x:Name="EditPartItem" Header="Modifica titolo e durata…" Click="EditPart_Click" />
                            <MenuItem x:Name="MovePartItem" Header="Sposta dopo la prossima" Click="MovePart_Click" />
                            <MenuItem x:Name="SkipPartItem" Header="Salta" Click="SkipPart_Click" />
                            <Separator />
                            <MenuItem x:Name="ResetPartItem" Header="Azzera il tempo di questa parte" Click="ResetPart_Click" />
                            <MenuItem x:Name="ResetAllItem" Header="Azzera tutti i tempi" Click="ResetAll_Click" />
                            <Separator />
                            <MenuItem Header="Evento fuori programma…" Click="FreeEvent_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═════ Avvisi ═════ -->
        <StackPanel Grid.Row="5">
            <DockPanel Margin="2,6,0,0" Visibility="{Binding HasClockWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE823;" FontSize="12"
                           Foreground="{StaticResource AmberBrush}" Margin="0,2,6,0" />
                <TextBlock Text="{Binding ClockWarning}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AmberBrush}" />
            </DockPanel>
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="2,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
