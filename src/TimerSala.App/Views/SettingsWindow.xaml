<Window x:Class="TimerSala.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Width="600" Height="860" ResizeMode="CanResize" MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Group">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Style="{StaticResource FlatButton}" Content="Cartella dati" Click="OpenData_Click" ToolTip="Apre la cartella con impostazioni, schemi salvati e diagnostica" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource FlatButton}" Content="Applica" Width="90" Margin="0,0,8,0" Click="Apply_Click"
                        ToolTip="Applica senza chiudere (utile per provare lo stile dello schermo)" />
                <Button Style="{StaticResource FlatButton}" Content="Annulla" IsCancel="True" Width="90" Margin="0,0,8,0" />
                <Button Style="{StaticResource FlatButton}" Content="Salva" IsDefault="True" Width="90" Click="Save_Click"
                        Background="{StaticResource AccentBrush}" BorderThickness="0" Foreground="White" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <!-- ADUNANZE -->
            <TabItem Header="Adunanze">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="ORARI" Style="{StaticResource Group}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Infrasettimanale" Style="{StaticResource Label}" />
                            <ComboBox x:Name="MidweekDay" Grid.Column="1" />
                            <TextBox x:Name="MidweekTime" Grid.Column="2" Margin="8,0,0,0" ToolTip="Ora di inizio, es. 19:00" />
                            <TextBlock Grid.Row="1" Text="Fine settimana" Style="{StaticResource Label}" Margin="0,8,12,0" />
                            <ComboBox x:Name="WeekendDay" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                            <TextBox x:Name="WeekendTime" Grid.Row="1" Grid.Column="2" Margin="8,8,0,0" ToolTip="Ora di inizio, es. 10:00" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Durata adunanza (min)" Style="{StaticResource Label}" Width="170" />
                            <TextBox x:Name="MeetingLength" Width="80" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Serve per calcolare la fine prevista. All'avvio viene proposta l'adunanza di oggi o la prossima." />

                        <TextBlock Text="DURATE ADATTIVE" Style="{StaticResource Group}" />
                        <CheckBox x:Name="AdaptiveStudy" Content="Studio biblico di congregazione adattivo" />
                        <CheckBox x:Name="AdaptiveWatchtower" Content="Studio Torre di Guardia adattivo" />
                        <TextBlock Style="{StaticResource Hint}" Text="Se l'adunanza è in ritardo, lo studio si accorcia (al massimo della metà) per finire in orario. Non si allunga mai oltre il tempo previsto. La durata adattata appare in arancione nell'elenco." />

                        <TextBlock Text="CONTO ALLA ROVESCIA PRIMA DELL'INIZIO" Style="{StaticResource Group}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Compare (minuti prima)" Style="{StaticResource Label}" Width="170" />
                            <TextBox x:Name="CountdownMinutes" Width="80" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Compare da solo prima dell'inizio e sparisce all'orario di inizio o quando avvii la prima parte. 0 = disattivato." />

                        <TextBlock Text="SCHEMI DA WOL.JW.ORG" Style="{StaticResource Group}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Lingua della guida" Style="{StaticResource Label}" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" />
                        </Grid>
                        <CheckBox x:Name="AutoDownload" Content="Scarica automaticamente le settimane non ancora salvate" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SCHERMO -->
            <TabItem Header="Schermo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="MONITOR DEL TIMER" Style="{StaticResource Group}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MonitorBox" />
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Identify_Click"
                                    ToolTip="Mostra per qualche secondo il numero su ogni schermo">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Identifica" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <CheckBox x:Name="ShowTimerWindow" Content="Mostra il timer su questo schermo" Margin="0,10,0,0" />

                        <TextBlock Text="ASPETTO" Style="{StaticResource Group}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tema" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Text="Layout" Style="{StaticResource Label}" Margin="0,8,12,0" />
                            <ComboBox x:Name="LayoutBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Text="Carattere" Style="{StaticResource Label}" Margin="0,8,12,0" />
                            <ComboBox x:Name="FontBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" IsEditable="True" />
                        </Grid>

                        <TextBlock Text="DURANTE IL TIMER" Style="{StaticResource Group}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Giallo quando mancano" Style="{StaticResource Label}" />
                            <TextBox x:Name="WarningSeconds" Width="64" HorizontalContentAlignment="Center" />
                            <TextBlock Text="secondi" Style="{StaticResource Label}" Margin="8,0,0,0" />
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="ColoredDigits" Content="Cifre colorate" ToolTip="Verde, giallo e rosso" />
                            <CheckBox x:Name="FlashOvertime" Content="Lampeggio allo scadere" />
                            <CheckBox x:Name="ShowTitle" Content="Titolo della parte" />
                            <CheckBox x:Name="ShowSection" Content="Sezione" ToolTip="Tesori, Ministero, Vita cristiana…" />
                            <CheckBox x:Name="ShowBar" Content="Barra di avanzamento" ToolTip="Solo nel layout classico" />
                            <CheckBox x:Name="ShowNextPart" Content="Parte successiva" />
                            <CheckBox x:Name="ShowClockRunning" Content="Ora in basso" />
                            <CheckBox x:Name="ShowDelay" Content="Ritardo al posto dell'ora" />
                        </UniformGrid>

                        <TextBlock Text="A TIMER FERMO" Style="{StaticResource Group}" />
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="ShowClock" Content="Orologio" />
                            <CheckBox x:Name="ShowNext" Content="Prossima parte" />
                        </UniformGrid>

                        <TextBlock Text="CONTROLLER" Style="{StaticResource Group}" />
                        <CheckBox x:Name="TopmostBox" Content="Finestra di controllo sempre in primo piano" />
                        <TextBlock Style="{StaticResource Hint}" Text="Lo stile vale anche per la pagina web. La modalità mini (tasto M) è sempre in primo piano." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- MESSAGGI -->
            <TabItem Header="Messaggi">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <CheckBox x:Name="MessagesEnabled" Content="Abilita i messaggi all'oratore" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                   Text="Se disattivati, la riga dei messaggi sparisce dal controller, dalla modalità mini e dalla pagina web." />
                        <TextBlock Text="Frasi pronte per l'oratore, una per riga:" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Durata sullo schermo (secondi)" Style="{StaticResource Label}" Width="210" />
                            <TextBox x:Name="MessageSeconds" Width="80" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="0 = il messaggio resta finché non lo togli. Puoi sempre scrivere un messaggio diverso nel controller." />
                    </StackPanel>
                    <TextBox x:Name="Presets" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" MinHeight="140" />
                </DockPanel>
            </TabItem>

            <!-- VOCE -->
            <TabItem x:Name="VoiceTab" Header="Voce (beta)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="AVVIO CON LA VOCE · SPERIMENTALE" Style="{StaticResource Group}" Margin="0,0,0,8" />
                        <CheckBox x:Name="VoiceEnabled" Content="Avvia le parti quando l'oratore inizia a parlare" />
                        <TextBlock Style="{StaticResource Hint}" Text="Premi Avvia mentre il presidente presenta la parte: il pulsante diventa «In attesa». Dopo una pausa, la prima voce fa partire il timer, contando dall'istante in cui la voce è iniziata. Premi di nuovo Avvia per partire subito; Esc annulla l'attesa o, nei primi secondi, un avvio sbagliato. Dal telefono l'avvio è sempre immediato." />

                        <TextBlock Text="INGRESSO AUDIO" Style="{StaticResource Group}" />
                        <ComboBox x:Name="VoiceDevice" SelectionChanged="VoiceDevice_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Text="Scegli l'ingresso che riceve l'audio del mixer (di solito lo stesso usato per Zoom). TimerSala lo ascolta in condivisione, senza disturbare gli altri programmi." />

                        <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="10" Background="{StaticResource CardBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Ellipse x:Name="VoiceLamp" Width="10" Height="10" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="VoiceLampText" Text="Silenzio" FontSize="12" Foreground="{StaticResource MutedBrush}" Width="56" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Prova: parla nel microfono" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Height="16">
                                    <Border Background="{StaticResource LineBrush}" CornerRadius="4" />
                                    <Border x:Name="VoiceMeter" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="#22C55E" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ThresholdLeft" Width="0.33*" />
                                            <ColumnDefinition Width="2" />
                                            <ColumnDefinition x:Name="ThresholdRight" Width="0.67*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Background="{StaticResource AmberBrush}" Margin="0,-3" />
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="VoiceTestStatus" Style="{StaticResource Hint}" Text="La barra mostra il livello dell'ingresso scelto. Il segno giallo è la soglia." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="REGOLAZIONI" Style="{StaticResource Group}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Soglia della voce" Style="{StaticResource Label}" />
                            <Slider x:Name="VoiceThreshold" Grid.Column="1" Minimum="-60" Maximum="-10" SmallChange="1" LargeChange="5"
                                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="VoiceSlider_Changed" />
                            <TextBlock x:Name="VoiceThresholdText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="Pausa prima della parte" Style="{StaticResource Label}" Margin="0,12,12,0" />
                            <Slider x:Name="VoicePause" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Minimum="1" Maximum="6" SmallChange="0.5" LargeChange="0.5"
                                    IsSnapToTickEnabled="True" TickFrequency="0.5" ValueChanged="VoiceSlider_Changed" />
                            <TextBlock x:Name="VoicePauseText" Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="Voce per almeno" Style="{StaticResource Label}" Margin="0,12,12,0" />
                            <Slider x:Name="VoiceMin" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Minimum="0.2" Maximum="1.5" SmallChange="0.1" LargeChange="0.1"
                                    IsSnapToTickEnabled="True" TickFrequency="0.1" ValueChanged="VoiceSlider_Changed" />
                            <TextBlock x:Name="VoiceMinText" Grid.Row="2" Grid.Column="2" Margin="0,12,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Soglia: con la sala in silenzio la barra deve restare sotto il segno giallo, quando si parla deve superarlo. Pausa: il silenzio che separa la presentazione dall'inizio della parte; deve essere più lungo delle pause tra una frase e l'altra del presidente. Voce per almeno: colpi, tosse e regolazioni del microfono più brevi di così vengono ignorati." />

                        <CheckBox x:Name="VoiceAutoArm" Content="Dopo Ferma, metti in attesa la parte successiva" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Text="Non vale se in mezzo c'è un cantico: dopo il cantico di solito parla prima il presidente." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- RETE -->
            <TabItem Header="Rete">
                <StackPanel Margin="12">
                    <CheckBox x:Name="WebEnabled" Content="Server web attivo (timer visibile da altri dispositivi in rete)" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Porta" Style="{StaticResource Label}" Width="170" />
                        <TextBox x:Name="WebPort" Width="90" />
                    </StackPanel>
                    <TextBlock Text="Indirizzo nei collegamenti e nei codici QR" Margin="0,12,0,6" />
                    <ComboBox x:Name="AddressBox" />
                    <TextBlock Style="{StaticResource Hint}" Text="Automatico usa la scheda di rete principale (quella con cui il PC esce in rete) e ignora le schede virtuali. Il nome del PC funziona solo se la rete lo risolve." />
                    <TextBlock Style="{StaticResource Hint}" Text="Se gli altri dispositivi non si collegano, controlla che Windows Firewall consenta TimerSala sulle reti private." />

                    <TextBlock Text="CONTROLLO REMOTO" Style="{StaticResource Group}" />
                    <CheckBox x:Name="RemoteEnabled" Content="Consenti di controllare il timer dalla pagina web (con PIN)" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PIN" Style="{StaticResource Label}" Width="170" />
                        <TextBox x:Name="RemotePin" Width="90" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Il PIN serve sul telefono per avviare, fermare, cambiare parte e inviare messaggi. Dopo 5 tentativi errati il controllo si blocca per un minuto. Il pulsante QR nel controller mostra un codice che contiene già il PIN." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
