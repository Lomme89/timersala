<Window x:Class="TimerSala.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimerSala mini" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" Icon="/Assets/timersala.ico"
        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="10,6,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- barra superiore: si trascina per spostare la finestra -->
        <DockPanel x:Name="DragBar" Background="Transparent" MouseLeftButtonDown="DragBar_MouseDown">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostIconButton}" Width="28" Height="26" FontSize="12" Content="&#xE740;"
                        Command="{Binding ToggleMiniCommand}" ToolTip="Torna alla finestra completa (M)" />
            </StackPanel>
            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding SectionBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource DigitsFont}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding DelayText}" Foreground="{Binding DelayBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding TitleText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding TitleText}" Margin="0,2,0,0" />

        <Grid Grid.Row="2" Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DisplayText}" Foreground="{Binding PhaseBrush}" FontFamily="{StaticResource DigitsFont}"
                       FontSize="46" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Parte precedente" />
                <Button Height="44" Width="64" Margin="6,0" Command="{Binding ToggleStartCommand}" ToolTip="Avvia / ferma (Spazio)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                            <Setter Property="Background" Value="#16A34A" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                            <Setter Property="FontSize" Value="20" />
                            <Setter Property="Content" Value="&#xE768;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="#DC2626" />
                                    <Setter Property="Content" Value="&#xE71A;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Parte successiva" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="3" Columns="2">
            <Button Style="{StaticResource FlatButton}" Padding="4,5" FontSize="12" Content="−1 min" Command="{Binding RemoveMinuteCommand}" Margin="0,0,3,0" />
            <Button Style="{StaticResource FlatButton}" Padding="4,5" FontSize="12" Content="+1 min" Command="{Binding AddMinuteCommand}" Margin="3,0,0,0" />
        </UniformGrid>
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox IsEditable="True" ItemsSource="{Binding MessagePresets}" FontSize="12" MinHeight="28"
                      Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" KeyDown="Message_KeyDown"
                      ToolTip="Messaggio per l'oratore (Invio per mostrarlo)" />
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="13" Content="&#xE724;" Margin="4,0,0,0"
                    Command="{Binding SendMessageCommand}" ToolTip="Mostra il messaggio" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="13" Content="&#xE711;" Margin="4,0,0,0"
                    Command="{Binding ClearMessageCommand}" ToolTip="Togli il messaggio">
                <Button.Visibility>
                    <Binding Path="HasMessage">
                        <Binding.Converter>
                            <BooleanToVisibilityConverter />
                        </Binding.Converter>
                    </Binding>
                </Button.Visibility>
            </Button>
        </Grid>
    </Grid>
</Window>
