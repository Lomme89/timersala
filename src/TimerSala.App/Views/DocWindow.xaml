<Window x:Class="TimerSala.App.Views.DocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimerSala" Width="640" Height="720" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="28,22,28,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="Subheading" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Chiudi" Width="110" IsCancel="True" IsDefault="True" Click="Close_Click"
                        Background="{DynamicResource AccentBrush}" BorderThickness="0" Foreground="White" />
                <WrapPanel x:Name="Actions" />
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,16,28,20">
            <StackPanel x:Name="Body" MaxWidth="720" HorizontalAlignment="Left" />
        </ScrollViewer>
    </DockPanel>
</Window>
