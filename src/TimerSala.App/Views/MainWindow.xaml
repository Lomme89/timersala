<Window x:Class="TimerSala.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimerSala.App.ViewModels"
        Title="TimerSala"
        Width="440" Height="800" MinWidth="380" MinHeight="560"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Icon="/Assets/timersala.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="PartTemplate" DataType="{x:Type vm:PartItemViewModel}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="8,7" Margin="0,1" Cursor="Hand"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding SectionBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTb" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="{StaticResource TextBrush}"
                                   ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" FontFamily="{StaticResource DigitsFont}" FontSize="14" />
                    <TextBlock x:Name="Actual" Grid.Column="3" Text="{Binding ActualText}" Foreground="{StaticResource GreenBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource DigitsFont}" FontSize="14" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSong}" Value="True">
                    <Setter TargetName="TitleTb" Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter TargetName="TitleTb" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="TitleTb" Property="FontSize" Value="13" />
                    <Setter TargetName="Row" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="Row" Property="Padding" Value="8,3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOver}" Value="True">
                    <Setter TargetName="Actual" Property="Foreground" Value="{StaticResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource CardHoverBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#1A22C55E" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostIconButton}" Content="&#xE73F;" ToolTip="Modalità mini (M)" Command="{Binding ToggleMiniCommand}" />
                <Button Style="{StaticResource GhostIconButton}" Content="&#xE70F;" ToolTip="Modifica schema (E)" Click="Edit_Click" />
                <Button Style="{StaticResource GhostIconButton}" Content="&#xE713;" ToolTip="Impostazioni" Click="Settings_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource DigitsFont}" FontSize="22" />
                <TextBlock Text="{Binding ClockSeconds}" FontFamily="{StaticResource DigitsFont}" FontSize="14"
                           Foreground="{StaticResource MutedBrush}" Margin="3,0,0,2" VerticalAlignment="Bottom" />
                <TextBlock Text="{Binding DelayText}" Foreground="{Binding DelayBrush}" FontSize="13" Margin="14,0,0,3"
                           VerticalAlignment="Bottom" ToolTip="Differenza accumulata rispetto ai tempi assegnati" />
            </StackPanel>
        </DockPanel>

        <!-- Settimana e adunanza -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE76B;" Command="{Binding PreviousWeekCommand}" ToolTip="Settimana precedente" />
                    <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource FlatButton}" Padding="4"
                            Command="{Binding ThisWeekCommand}" ToolTip="Torna alla settimana corrente">
                        <StackPanel>
                            <TextBlock Text="{Binding WeekTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WeekSubtitle}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource GhostIconButton}" Content="&#xE76C;" Command="{Binding NextWeekCommand}" ToolTip="Settimana successiva" />
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding DownloadCommand}" Margin="4,0,0,0"
                            ToolTip="Scarica lo schema da wol.jw.org">
                        <Grid>
                            <TextBlock Text="&#xE896;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource BgBrush}" CornerRadius="8">
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Infrasettimanale" IsChecked="{Binding IsMidweek}" GroupName="kind" />
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Fine settimana" IsChecked="{Binding IsWeekend}" GroupName="kind" />
                        </UniformGrid>
                    </Border>
                    <ToggleButton Grid.Column="1" Style="{StaticResource PillToggle}" Margin="8,0,0,0" IsChecked="{Binding OverseerVisit}"
                                  ToolTip="Settimana della visita del sorvegliante di circoscrizione">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Sorvegliante" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <TextBlock Text="{Binding ScheduleText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Timer corrente -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Background="{Binding SectionBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding SectionText}" Style="{StaticResource Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding TitleText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DisplayText}" Foreground="{Binding PhaseBrush}" FontFamily="{StaticResource DigitsFont}"
                           FontSize="68" HorizontalAlignment="Center" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding PhaseBrush}" />
                <TextBlock Text="{Binding InfoText}" Style="{StaticResource Caption}" Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Comandi -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Width="50" Height="56" Content="&#xE892;" Command="{Binding PreviousCommand}" ToolTip="Parte precedente (←)" />
                <Button x:Name="StartButton" Grid.Column="1" Height="56" Margin="6,0" Command="{Binding ToggleStartCommand}"
                        ToolTip="Avvia / ferma (barra spaziatrice)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                            <Setter Property="Background" Value="#16A34A" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="White" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="#DC2626" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="AVVIA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="FERMA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="50" Height="56" Content="&#xE893;" Command="{Binding NextCommand}" ToolTip="Parte successiva (→)" HorizontalAlignment="Right" />
            </Grid>
            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Style="{StaticResource FlatButton}" Content="−1 min" Command="{Binding RemoveMinuteCommand}" Margin="0,0,3,0" ToolTip="Togli un minuto (−)" />
                <Button Style="{StaticResource FlatButton}" Content="+1 min" Command="{Binding AddMinuteCommand}" Margin="3,0,0,0" ToolTip="Aggiungi un minuto (+)" />
            </UniformGrid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MessageInput" IsEditable="True" ItemsSource="{Binding MessagePresets}"
                          Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" KeyDown="MessageInput_KeyDown"
                          ToolTip="Messaggio per l'oratore: scegli una frase o scrivila e premi Invio" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE724;" Margin="6,0,0,0"
                        Command="{Binding SendMessageCommand}" ToolTip="Mostra il messaggio sullo schermo" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0"
                        Command="{Binding ClearMessageCommand}" ToolTip="Togli il messaggio" />
            </Grid>
            <TextBlock Text="{Binding MessageInfo}" Foreground="{StaticResource AmberBrush}" FontSize="12" Margin="2,4,0,0"
                       TextTrimming="CharacterEllipsis" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Elenco parti -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="6">
            <ListBox x:Name="PartsList" ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource PartTemplate}" Foreground="{StaticResource TextBrush}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="PartsList_Click" PreviewMouseRightButtonUp="PartsList_RightClick" Focusable="False">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="ResetPartItem" Header="Azzera il tempo della parte selezionata" Click="ResetPart_Click" />
                        <MenuItem x:Name="ResetAllItem" Header="Azzera tutti i tempi" Click="ResetAll_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Schermo e rete -->
        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" VerticalAlignment="Center" Margin="2,0,8,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="16" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableMonitors}" SelectedItem="{Binding SelectedMonitor}"
                          ToolTip="Schermo su cui mostrare il timer" />
                <CheckBox Grid.Column="2" Content="Mostra" IsChecked="{Binding TimerWindowVisible}" Margin="8,0,0,0" VerticalAlignment="Center"
                          ToolTip="Mostra o nasconde il timer sullo schermo scelto" />
                <Button Grid.Column="3" Style="{StaticResource GhostIconButton}" Content="&#xE7F8;" Click="Identify_Click"
                        ToolTip="Identifica gli schermi" />
            </Grid>
            <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE774;" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Margin="2,0,8,0" FontSize="14" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Width="30" Height="26" FontSize="14" Content="&#xED14;"
                        Click="Qr_Click" ToolTip="Codici QR per vedere o controllare il timer dal telefono" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13">
                    <Hyperlink x:Name="WebLink" Click="WebLink_Click" Foreground="{StaticResource AccentBrush}">
                        <Run Text="{Binding WebStatus, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </DockPanel>
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Margin="2,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
