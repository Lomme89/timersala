<Window x:Class="TimerSala.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TimerSala.App.Views"
        Title="Benvenuto in TimerSala" Width="620" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StepText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" Content="Salta" Width="96" Margin="0,0,8,0" Click="Skip_Click"
                            ToolTip="Puoi sempre cambiare tutto in Impostazioni" />
                    <Button x:Name="BackButton" Style="{StaticResource FlatButton}" Content="Indietro" Width="96" Margin="0,0,8,0" Click="Back_Click" />
                    <Button Style="{StaticResource FlatButton}" Content="{Binding NextText}" Width="110" IsDefault="True" Click="Next_Click"
                            Background="{StaticResource AccentBrush}" BorderThickness="0" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="32,28,32,16">
            <!-- 1 · schermo della sala -->
            <StackPanel Visibility="{Binding IsScreenStep, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource StepTitle}" Text="Dove va il timer?" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="Scegli lo schermo che vede l'oratore. Il timer compare subito lì, così controlli che sia quello giusto. «Identifica» mostra il numero su ogni schermo." />
                <ListBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="200">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="2"
                                                CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="15" Foreground="{StaticResource TextBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Identifica" Padding="12,5" Click="Identify_Click" />
                    <RadioButton Content="Nessuno per ora (solo sul telefono o in seguito)" IsChecked="{Binding NoScreen}" FontSize="13.5"
                                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>

            <!-- 2 · orari -->
            <StackPanel Visibility="{Binding IsTimesStep, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource StepTitle}" Text="Quando vi riunite?" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="Servono per il countdown prima dell'inizio, la fine prevista e per proporre l'adunanza giusta all'apertura." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Infrasettimanale" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Days}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MidweekDay}" />
                    <v:TimeBox Grid.Column="2" Width="96" Margin="8,0,0,0" Time="{Binding MidweekTime}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Fine settimana" Margin="0,12,0,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" ItemsSource="{Binding Days}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding WeekendDay}" />
                    <v:TimeBox Grid.Row="1" Grid.Column="2" Width="96" Margin="8,12,0,0" Time="{Binding WeekendTime}" />
                </Grid>
                <TextBlock Style="{StaticResource StepText}" Margin="0,18,0,0"
                           Text="Le visite del sorvegliante, con l'infrasettimanale in un altro giorno, si segnano in Impostazioni → Adunanze." />
            </StackPanel>

            <!-- 3 · telefono -->
            <StackPanel Visibility="{Binding IsPhoneStep, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource StepTitle}" Text="Prova con il telefono" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="Collega il telefono alla stessa rete Wi-Fi del PC e inquadra il codice: vedrai il timer in tempo reale. Il codice per comandarlo, con il PIN, è nell'icona della rete in alto nel controller." />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasWebUrl, Converter={StaticResource BoolToVis}}">
                    <Border Background="White" CornerRadius="8" Padding="6">
                        <Image x:Name="QrImage" Width="190" Height="190" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" MaxWidth="280">
                        <TextBlock Text="Oppure scrivi nel browser:" Style="{StaticResource Caption}" FontSize="13" />
                        <TextBlock Text="{Binding WebUrl}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource StepText}" x:Name="NoWebText" Text="Il timer in rete è spento: si accende in Impostazioni → Rete e telefono. Puoi saltare questo passo." />
            </StackPanel>

            <!-- 4 · fine -->
            <StackPanel Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource StepTitle}" Text="Tutto pronto" />
                <TextBlock Style="{StaticResource StepText}"
                           Text="Lo schema della settimana arriva da solo da wol.jw.org. Spazio avvia e ferma, M passa alla modalità mini, F1 apre la guida." />
                <CheckBox Content="Metti un collegamento sul desktop" IsChecked="{Binding DesktopShortcut}" FontSize="14" Margin="0,0,0,10"
                          Foreground="{StaticResource TextBrush}" />
                <CheckBox Content="Apri TimerSala all'avvio di Windows" IsChecked="{Binding StartWithWindows}" FontSize="14"
                          Foreground="{StaticResource TextBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
