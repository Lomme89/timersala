<Window x:Class="TimerSala.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimerSala.App.ViewModels"
        Title="Modifica schema" Language="it-IT" Width="920" Height="880" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <!-- riga dell'elenco delle parti -->
        <DataTemplate x:Key="PartRow" DataType="{x:Type vm:EditablePart}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.6" ToolTip="Trascina per spostare" Cursor="SizeAll" />
                <Border Grid.Column="1" Background="{Binding SectionBrush}" CornerRadius="2" />
                <TextBlock x:Name="T" Grid.Column="2" Text="{Binding DisplayTitle}" Margin="10,0,8,0" FontSize="14"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                <Border Grid.Column="3" Background="{DynamicResource BgBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource DigitsFont}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSong}" Value="True">
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="T" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="PartItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="8,8" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pulsanti colorati delle sezioni -->
        <Style x:Key="SectionChip" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="16" Padding="12,6" Margin="0,0,6,6" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource BgBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Label}" FontSize="13" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Brush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeSegment" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style x:Key="MinuteChip" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontFamily" Value="{StaticResource DigitsFont}" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- intestazione -->
        <DockPanel Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalText}" FontSize="13" />
            </Border>
            <StackPanel>
                <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WeekText}" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" />
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AmberBrush}" Background="#1FFBBF24" Padding="10,5" Margin="0,8,0,0"
                        HorizontalAlignment="Left" Visibility="{Binding HasOverrun, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding OverrunText}" Foreground="{DynamicResource AmberBrush}" FontSize="12.5" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- elenco -->
            <Border Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding AddPartCommand}" Margin="0,0,4,0" ToolTip="Aggiungi una parte dopo quella selezionata">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Parte" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" Command="{Binding AddSongCommand}" Margin="4,0" ToolTip="Aggiungi un cantico dopo la parte selezionata">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Cantico" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70E;" Command="{Binding MoveUpCommand}" Margin="4,0" ToolTip="Sposta su (Alt+↑)" />
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE70D;" Command="{Binding MoveDownCommand}" ToolTip="Sposta giù (Alt+↓)" />
                    </Grid>
                    <ListBox x:Name="PartsList" ItemsSource="{Binding Parts}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource PartRow}"
                             ItemContainerStyle="{StaticResource PartItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseLeftButtonDown="List_PreviewMouseDown" PreviewMouseMove="List_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="List_PreviewMouseUp" LostMouseCapture="List_LostMouseCapture"
                             PreviewKeyDown="List_PreviewKeyDown" />
                </DockPanel>
            </Border>

            <!-- dettaglio -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,8,20,16">
                <Grid>
                    <TextBlock Text="Seleziona una parte a sinistra o aggiungine una nuova." FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Selected}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                    <Button Style="{StaticResource GhostIconButton}" Width="32" Height="30" FontSize="14" Content="&#xE8C8;"
                                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Duplica la parte" />
                                    <Button Style="{StaticResource GhostIconButton}" Width="32" Height="30" FontSize="14" Content="&#xE74D;" Foreground="{DynamicResource RedBrush}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Elimina la parte (Canc)" />
                                </StackPanel>
                                <TextBlock Text="TITOLO" Style="{StaticResource FieldLabel}" />
                            </DockPanel>
                            <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8,7" />

                            <TextBlock Text="TIPO" Style="{StaticResource FieldLabel}" />
                            <Border Background="{DynamicResource BgBrush}" CornerRadius="8" HorizontalAlignment="Left" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Parte cronometrata" Command="{Binding DataContext.SetTimedCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TypeSegment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSong}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Cantico (senza timer)" Command="{Binding DataContext.SetSongCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TypeSegment}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSong}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <StackPanel Visibility="{Binding IsTimed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="DURATA" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE738;" Width="44" Height="44"
                                            Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Un minuto in meno" />
                                    <TextBox Text="{Binding Minutes, StringFormat={}{0:0.##}}" Width="84" Margin="8,0" FontSize="24"
                                             FontFamily="{StaticResource DigitsFont}" HorizontalContentAlignment="Center" Padding="4,4" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" Width="44" Height="44"
                                            Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Un minuto in più" />
                                    <TextBlock Text="minuti" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DataContext.QuickMinutes, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MinuteChip}" Content="{Binding}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.SetMinutesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox Content="Contiene un video (da preparare in JW Library)" IsChecked="{Binding HasVideo}" Margin="0,12,0,0"
                                          Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>

                            <TextBlock Text="SEZIONE" Style="{StaticResource FieldLabel}" />
                            <ListBox ItemsSource="{Binding DataContext.Sections, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedValuePath="Value" SelectedValue="{Binding Section}" ItemContainerStyle="{StaticResource SectionChip}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <TextBlock Text="NOTE (FACOLTATIVE)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Detail, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="Wrap"
                                     ToolTip="Es. scrittura o lezione; compare sotto il titolo nel controller" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- piè di pagina -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                        ToolTip="Annulla l'ultima modifica (Ctrl+Z)" />
                <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                        ToolTip="Ripeti (Ctrl+Y)" Margin="4,0,12,0" />
                <Button Style="{StaticResource FlatButton}" Content="Ripristina scaricato" Command="{Binding RestoreDownloadedCommand}" Margin="0,0,8,0"
                        ToolTip="Torna allo schema scaricato da wol.jw.org (o al modello se non scaricato)" />
                <Button Style="{StaticResource FlatButton}" Content="Modello standard" Command="{Binding UseTemplateCommand}"
                        ToolTip="Schema standard senza titoli specifici" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource FlatButton}" Content="Annulla" IsCancel="True" Width="110" Margin="0,0,8,0" />
                <Button Style="{StaticResource FlatButton}" Content="Salva" Width="110" Click="Save_Click"
                        Background="{DynamicResource AccentBrush}" BorderThickness="0" Foreground="White" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
